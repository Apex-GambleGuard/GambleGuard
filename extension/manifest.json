{
  "manifest_version": 3,
  "name": "GambleGuard",
  "version": "0.1.0",
  "description": "Helping people stay gambling-free by blocking gambling websites.",
  "permissions": [
    "tabs",
    "storage",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "GambleGuard"
  }
}
