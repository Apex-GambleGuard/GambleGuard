{
  "manifest_version": 3,
  "name": "GambleGuard",
  "version": "0.1.0",
  "description": "Blocks gambling websites.",
  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "GambleGuard"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "src/block.html",
        "src/rules.json"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}